# Database (Vercel Postgres with pgvector)
DATABASE_URL=
POSTGRES_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Slack App (create at api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Linear OAuth (create at linear.app/settings/api)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# GitHub OAuth (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion Integration (create at notion.so/my-integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Inngest (optional, for background jobs)
INNGEST_SIGNING_KEY=

# E2B (for AI code generation sandbox)
E2B_API_KEY=

# Note: OpenRouter API key is set per-workspace in Settings UI
